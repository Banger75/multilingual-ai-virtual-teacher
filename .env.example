# ================= APPLICATION =================
APP_NAME=Subject Specific AI Assistant
APP_VERSION=1.0.0

# ================= LLM =================
# Local Windows + Docker: LM Studio must have its server enabled.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.2

# Cloud: replace the three LLM values above with your OpenAI-compatible provider.

# ================= QDRANT =================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=class5_books

# ================= EMBEDDINGS =================
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ================= SPEECH =================
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENABLED=true

# English Piper model is included/mounted locally.
PIPER_EN_MODEL=/app/tools/piper/models/en_US-lessac-medium.onnx
# Add Hindi/Punjabi Piper model files later and set these paths.
PIPER_HI_MODEL=
PIPER_PA_MODEL=

# Punjabi TTS: local, open-source AI4Bharat IndicF5 model. On its first use,
# accept the model's Hugging Face access terms and allow the model to download.
INDICF5_MODEL_ID=ai4bharat/IndicF5
INDICF5_PROMPT_AUDIO=/app/IndicF5/prompts/PAN_F_HAPPY_00002.wav
INDICF5_LOCAL_FILES_ONLY=false

# Optional vision model as configured in backend/config.py
VISION_MODEL=qwen/qwen3-vl-4b
